# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # Always use https
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # /index.php/shop  ->  /shop  (GET only, so POST bodies are never lost)
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/index\.php/(\S*) [NC]
    RewriteRule ^ /%1 [L,R=301]

    # Strip a trailing slash
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send everything that is not a real file/folder to the front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

    # Ensure Authorization header is passed along
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Works even when mod_rewrite is unavailable. Unlike ErrorDocument it is an
# internal subrequest, so POST requests keep their method and body.
<IfModule !mod_rewrite.c>
    <IfModule mod_dir.c>
        FallbackResource /index.php
    </IfModule>
</IfModule>

# Disable server signature start
ServerSignature Off
# Disable server signature end
